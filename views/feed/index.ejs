<% const query = typeof searchTerm === 'string' && searchTerm.length > 0 ? searchTerm : ''; %>
<nav class="navbar">
  <div class="navbar-content">
    <h1 class="logo">Twitter-like</h1>
    <div class="nav-links">
      <a href="/feed" class="nav-link">Home</a>
      <a href="/search<%= query ? '?q=' + encodeURIComponent(query) : '' %>" class="nav-link">Search<%= query ? ' (' + query + ')' : '' %></a>
      <a href="/messages" class="nav-link">Messages</a>
      <a href="/analytics" class="nav-link">Analytics</a>
    </div>
    <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme">
      <% const t = typeof theme; if (t === 'string' && theme === 'dark') { %>☀️<% } else if (t === 'string' && theme === 'light') { %>🌙<% } else { %>◑<% } %>
    </button>
  </div>
</nav>

<div class="card" style="margin-top: 16px;">
  <div class="composer">
    <form hx-post="/api/posts" hx-target="#feed" hx-swap="innerHTML" enctype="multipart/form-data" onsubmit="return false;">
      <div class="form-group">
        <textarea id="post-body" name="body" placeholder="What's happening?!" rows="3" maxlength="280"></textarea>
        <div class="error-message" id="post-body-error"></div>
      </div>
      
      <div class="form-group" style="margin-bottom: 0;">
        <input type="file" id="post-file" name="file" accept="image/*,video/*" style="display:none">
        <label for="post-file" class="btn btn-secondary">
          <% if (mediaPreview) { %>📎<% } else { %>Add Media<% } %>
        </label>
        <div class="error-message" id="file-error"></div>
      </div>
      
      <div class="composer-actions">
        <div id="composer-status"></div>
        <button type="submit" class="btn btn-primary">Post</button>
      </div>
    </form>
  </div>
</div>

<div id="feed" class="card" style="padding: 0;">
  <div id="feed-content">
    <% if (posts && posts.length > 0) { %>
      <% for (var i = 0; i < posts.length; i++) { %>
        <% var post = posts[i]; %>
        <% var username = userMap[post.user_id] ? userMap[post.user_id].username : ''; %>
        <% var displayName = userMap[post.user_id] ? (userMap[post.user_id].display_name || userMap[post.user_id].username) : 'Unknown User'; %>
        <article class="post" data-post-id="<%= post.id %>" style="background: var(--card-bg, #fff); border: 1px solid var(--border-color, #ddd); border-radius: 8px; padding: 12px; margin-bottom: 8px;">
          <div class="post-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <a href="/u/<%= username %>" class="username" style="color: var(--link-color, #1da1f2); text-decoration: none; font-weight: bold;"><%= displayName %></a>
            <span class="post-time" style="color: var(--text-muted, #666); font-size: 14px;"><%= post.created_at %></span>
          </div>
          
          <div class="post-body" style="margin-bottom: 8px; line-height: 1.5;">
            <%= typeof post.body === 'string' ? post.body : '' %>
          </div>
          
          <% if (post.type === 'repost') { %>
            <% var repostUser = userMap[post.user_id] ? (userMap[post.user_id].display_name || userMap[post.user_id].username) : 'Unknown'; %>
            <div class="repost-info" style="color: var(--text-muted, #666); font-size: 14px; margin-bottom: 8px;">Reposted by <%= repostUser %></div>
          <% } %>
          
          <div class="post-actions" style="display: flex; gap: 8px; border-top: 1px solid var(--border-color, #ddd); padding-top: 8px;">
            <button class="action-btn" onclick="likePost('<%= post.id %>')" style="background: none; border: none; cursor: pointer; padding: 4px 8px; font-size: 14px; color: var(--text-color, #333);">❤️ Like</button>
            <button class="action-btn" onclick="repostPost('<%= post.id %>')" style="background: none; border: none; cursor: pointer; padding: 4px 8px; font-size: 14px; color: var(--text-color, #333);">🔄 Repost</button>
            <button class="action-btn" onclick="sharePost('<%= post.id %>', '<%= encodeURIComponent(typeof post.body === 'string' ? post.body : '') %>')" style="background: none; border: none; cursor: pointer; padding: 4px 8px; font-size: 14px; color: var(--text-color, #333);">📤 Share</button>
          </div>
        </article>
      <% } %>
    <% } else { %>
      <div class="empty-state" style="text-align: center; padding: 48px 24px; color: var(--text-muted, #666);">
        <div class="empty-icon" style="font-size: 48px; margin-bottom: 16px;">📋</div>
        <h3 style="margin-bottom: 8px; color: var(--text-color, #333);">No posts yet</h3>
        <p>Be the first to post something! Share your thoughts, photos, or videos.</p>
      </div>
    <% } %>
  </div>
  
  <!-- Infinite scroll sentinel -->
  <div id="infinite-scroll-sentinel" style="height: 1px;"></div>
</div>

<div class="card" style="margin-top: 16px;">
  <div style="position: relative;">
    <div style="display: flex; gap: 8px; padding: 12px; border-bottom: 1px solid var(--border-color);">
      <input type="text" id="search-input" placeholder="Search posts, users..." style="flex: 1; padding: 8px 12px; border: 1px solid var(--border-color); border-radius: 999px; background: var(--bg-primary); color: var(--text-primary);">
      <button class="btn btn-secondary" onclick="searchPosts()">Search</button>
    </div>
    <div id="search-suggestions" style="position: absolute; top: 100%; left: 0; right: 0; background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 0 0 999px 999px; max-height: 200px; overflow-y: auto; display: none; z-index: 10;"></div>
  </div>
  <div id="search-results" class="empty-state" style="padding: 16px;">
    <p>Search results will appear here</p>
  </div>
</div>

<script>
let mediaPreview = null;
let lastPostId = null;

// Infinite scroll functionality
document.addEventListener('DOMContentLoaded', function() {
  const sentinel = document.getElementById('infinite-scroll-sentinel');
  
  if (sentinel) {
    const observer = new IntersectionObserver(function(entries) {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          loadMorePosts();
        }
      });
    }, { threshold: 0.1 });
    
    observer.observe(sentinel);
  }
});

async function loadMorePosts() {
  try {
    const response = await fetch('/api/feed?sinceId=' + lastPostId, {
      headers: { 'Accept': 'application/json' }
    });
    
    if (!response.ok) throw new Error('Failed to load more posts');
    
    const data = await response.json();
    
    if (data.posts && data.posts.length > 0) {
      lastPostId = data.next_cursor;
      
      const feedContent = document.getElementById('feed-content');
      if (feedContent) {
        // Add new posts before the sentinel
        var newPostsHtml = '';
        for (var j = 0; j < data.posts.length; j++) {
          var dp = data.posts[j];
          var dusername = (data.users && data.users.find(function(u) { return u.id === dp.user_id; })) ? data.users.find(function(u) { return u.id === dp.user_id; }).username : '';
          var ddisplayname = (data.users && data.users.find(function(u) { return u.id === dp.user_id; })) ? (data.users.find(function(u) { return u.id === dp.user_id; }).display_name || data.users.find(function(u) { return u.id === dp.user_id; }).username) : 'Unknown User';
          
          newPostsHtml += '<article class="post" data-post-id="' + dp.id + '" style="background: var(--card-bg, #fff); border: 1px solid var(--border-color, #ddd); border-radius: 8px; padding: 12px; margin-bottom: 8px;">';
          newPostsHtml += '<div class="post-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">';
          newPostsHtml += '<a href="/u/' + dusername + '" style="color: var(--link-color, #1da1f2); text-decoration: none; font-weight: bold;">' + escapeHtml(ddisplayname) + '</a>';
          newPostsHtml += '<span class="post-time" style="color: var(--text-muted, #666); font-size: 14px;">' + dp.created_at + '</span>';
          newPostsHtml += '</div>';
          newPostsHtml += '<div class="post-body" style="margin-bottom: 8px; line-height: 1.5;">' + escapeHtml(typeof dp.body === 'string' ? dp.body : '') + '</div>';
          newPostsHtml += '</article>';
        }
        
        sentinel.insertAdjacentHTML('beforebegin', newPostsHtml);
      }
    }
  } catch (error) {
    console.error('Error loading more posts:', error);
  }
}

// Like post
function likePost(postId) {
  fetch('/api/posts/' + postId + '/like', { method: 'POST' })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        alert('Post liked!');
      } else {
        alert('Error liking post');
      }
    })
    .catch(error => alert('Error: ' + error));
}

// Repost post
function repostPost(postId) {
  if (!confirm('Repost this?')) return;
  
  fetch('/api/posts/' + postId + '/repost', { method: 'POST' })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        alert('Post reposted!');
      } else {
        alert('Error reposting post');
      }
    })
    .catch(error => alert('Error: ' + error));
}

// Share post
function sharePost(postId, text) {
  if (navigator.share) {
    navigator.share({
      title: 'Check out this post',
      text: text,
      url: window.location.href
    });
  } else {
    navigator.clipboard.writeText(window.location.href).then(() => {
      alert('Link copied to clipboard!');
    }).catch(err => {
      alert('Failed to copy link');
    });
  }
}

// Toggle theme
function toggleTheme() {
  const newTheme = document.querySelector('[data-theme]');
  if (newTheme.getAttribute('data-theme') === 'system') {
    newTheme.setAttribute('data-theme', 'light');
  } else if (newTheme.getAttribute('data-theme') === 'light') {
    newTheme.setAttribute('data-theme', 'dark');
  } else {
    newTheme.setAttribute('data-theme', 'system');
  }
  localStorage.setItem('theme', newTheme.getAttribute('data-theme'));
}

// Media file handler
document.getElementById('post-file').addEventListener('change', function(e) {
  const file = e.target.files[0];
  if (!file) return;
  
  // Validate file type
  const validTypes = ['image/jpeg', 'image/png', 'image/gif', 'video/mp4', 'video/webm'];
  if (!validTypes.includes(file.type)) {
    document.getElementById('file-error').textContent = 'Invalid file type. Please use JPG, PNG, GIF, MP4, or WEBM';
    return;
  }
  
  // Validate file size (max 10MB)
  if (file.size > 10 * 1024 * 1024) {
    document.getElementById('file-error').textContent = 'File too large. Maximum size is 10MB';
    return;
  }
  
  // Show preview
  if (file.type.startsWith('image/')) {
    const reader = new FileReader();
    reader.onload = function(e) {
      mediaPreview = e.target.result;
      document.querySelector('#post-file + label').innerHTML = '<img src="' + e.target.result + '" style="max-height:100px">';
    };
    reader.readAsDataURL(file);
  } else {
    mediaPreview = file;
    document.querySelector('#post-file + label').textContent = 'Video preview';
  }
  
  // Clear error
  document.getElementById('file-error').textContent = '';
});

document.querySelector('form').addEventListener('submit', function(e) {
  e.preventDefault();
  
  const body = document.getElementById('post-body').value.trim();
  const fileInput = document.getElementById('post-file');
  
  // Validation
  if (body.length > 280) {
    document.getElementById('post-body-error').textContent = 'Post must be 280 characters or less';
    return;
  }
  
  if (!body && !fileInput.files[0]) {
    document.getElementById('post-body-error').textContent = 'Please write something or attach a file';
    return;
  }
  
  // Clear errors
  document.getElementById('post-body-error').textContent = '';
  document.getElementById('file-error').textContent = '';
  document.getElementById('composer-status').textContent = 'Posting...';
  
  const formData = new FormData();
  formData.append('body', body);
  
  if (fileInput.files[0]) {
    formData.append('file', fileInput.files[0]);
  }
  
  // Use fetch instead of htmx for this demo
  const form = e.target;
  form.reset();
  mediaPreview = null;
  
  const submitBtn = form.querySelector('button[type="submit"]');
  const originalText = submitBtn.textContent;
  submitBtn.disabled = true;
  submitBtn.textContent = 'Posting...';
  
  fetch('/api/posts', {
    method: 'POST',
    headers: { 'Accept': 'application/json' },
    body: formData
  }).then(response => response.json())
    .then(data => {
      if (data.success) {
        window.location.reload();
      } else {
        document.getElementById('composer-status').textContent = data.error;
      }
    })
    .catch(error => {
      console.error('Post error:', error);
      document.getElementById('composer-status').textContent = 'An error occurred. Please try again.';
    })
    .finally(() => {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    });
});

function searchPosts() {
  const query = document.getElementById('search-input').value.trim();
  if (!query) return;
  
  // Hide suggestions
  hideSuggestions();
  
  fetch('/api/search?q=' + encodeURIComponent(query)).then(response => response.json()).then(data => {
    const results = document.getElementById('search-results');
    if (data.posts && data.posts.length > 0) {
      results.innerHTML = data.posts.map(function(post) {
        var uname = (data.users && data.users.find(function(u) { return u.id === post.user_id; })) ? data.users.find(function(u) { return u.id === post.user_id; }).username : '';
        var dname = (data.users && data.users.find(function(u) { return u.id === post.user_id; })) ? (data.users.find(function(u) { return u.id === post.user_id; }).display_name || data.users.find(function(u) { return u.id === post.user_id; }).username) : 'Unknown User';
        
        return '<article class="post" style="background: var(--card-bg, #fff); border: 1px solid var(--border-color, #ddd); border-radius: 8px; padding: 12px; margin-bottom: 8px;">' +
          '<div class="post-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">' +
          '<a href="/u/' + uname + '" style="color: var(--link-color, #1da1f2); text-decoration: none; font-weight: bold;"><%= dname %></a>' +
          '<span class="post-time" style="color: var(--text-muted, #666); font-size: 14px;">' + post.created_at + '</span>' +
          '</div>' +
          '<div class="post-body" style="margin-bottom: 8px; line-height: 1.5;">' + escapeHtml(post.body || '') + '</div>' +
          '</article>';
      }).join('');
    } else {
      results.innerHTML = '<div class="empty-state"><p>No results found.</p></div>';
    }
  }).catch(error => {
    console.error('Search error:', error);
    document.getElementById('search-results').innerHTML = '<div class="empty-state"><p>Error searching.</p></div>';
  });
}

function showSuggestions(suggestions) {
  const container = document.getElementById('search-suggestions');
  if (suggestions && suggestions.length > 0) {
    container.innerHTML = suggestions.map(function(s) {
      return '<div style="padding: 8px 12px; cursor: pointer;" data-username="' + escapeHtml(s.username) + '">' +
        '<span style="font-weight: 600;">' + escapeHtml(s.display_name || s.username) + '</span> <span style="color: var(--text-secondary);">@' + escapeHtml(s.username) + '</span>' +
        '</div>';
    }).join('');
    container.style.display = 'block';
  } else {
    hideSuggestions();
  }
}

function hideSuggestions() {
  document.getElementById('search-suggestions').style.display = 'none';
}

// Auto-show suggestions on input
let searchTimeout;
document.getElementById('search-input').addEventListener('input', function(e) {
  clearTimeout(searchTimeout);
  const query = e.target.value.trim();
  if (query.length < 2) {
    hideSuggestions();
    return;
  }
  
  searchTimeout = setTimeout(() => {
    fetch('/api/suggestions?q=' + encodeURIComponent(query)).then(response => response.json()).then(data => {
      showSuggestions(data.suggestions);
    }).catch(() => hideSuggestions());
  }, 300);
});

// Handle suggestion clicks
document.addEventListener('click', function(e) {
  if (!e.target.closest('#search-suggestions')) {
    hideSuggestions();
  }
});

document.getElementById('search-suggestions').addEventListener('click', function(e) {
  const username = e.target.getAttribute('data-username');
  if (username) {
    document.getElementById('search-input').value = username;
    hideSuggestions();
    window.location.href = '/u/' + encodeURIComponent(username);
  }
});

// Auto-submit search on Enter key
document.getElementById('search-input').addEventListener('keypress', function(e) {
  if (e.key === 'Enter') {
    searchPosts();
  }
});
</script>

<style>
