  text-align: center;
  padding: 48px 24px;
  color: var(--text-muted, #666);
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 16px;
}

.empty-state h3 {
  margin-bottom: 8px;
  color: var(--text-color, #333);
}

