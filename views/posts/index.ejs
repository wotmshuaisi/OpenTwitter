<% include '../partials/nav.ejs' %>

<h1 class="text-center" style="margin-top: 40px;">Your Posts</h1>

<div class="card" style="margin-top: 24px;">
  <% if (posts && posts.length > 0) { %>
    <% posts.forEach(post => { %>
      <div class="post">
        <article class="post">
          <div class="post-header">
            <a href="/u/<%= post.user.username %>">
              <% if (post.user.avatar_media_id) { %>
                <img class="post-author" src="/media/<%= post.user.avatar_media_id %>storage_key" alt="<%= post.user.display_name %>">
              <% } else { %>
                <div class="post-author" style="width:40px;height:40px;background:var(--bg-secondary);border-radius:50%;"></div>
              <% } %>
            </a>
            <div>
              <a href="/u/<%= post.user.username %>" class="post-author-name"><%= post.user.display_name %></a>
              <span class="post-author-handle">@<%= post.user.username %></span>
              <span class="post-meta">· <%= new Date(post.created_at).toLocaleDateString() %></span>
            </div>
          </div>
          
          <% if (post.type === 'repost') { %>
            <div class="post-meta" style="color:var(--text-secondary);margin-bottom:8px;">
              Reposted by <a href="/u/<%= post.user.username %>"><%= post.user.display_name %></a>
            </div>
          <% } %>
          
          <div class="post-body">
            <%= escapeHtml(post.body || '') %>
          </div>
          
          <% if (post.repost_of_id) { %>
            <article class="original-post">
              <div class="post-header">
                <a href="/u/<%= post.user.username %>">
                  <% if (post.user.avatar_media_id) { %>
                    <img class="post-author" src="/media/<%= post.user.avatar_media_id %>storage_key" alt="<%= post.user.display_name %>">
                  <% } else { %>
                    <div class="post-author" style="width:40px;height:40px;background:var(--bg-secondary);border-radius:50%;"></div>
                  <% } %>
                </a>
                <div>
                  <a href="/u/<%= post.user.username %>" class="post-author-name"><%= post.user.display_name %></a>
                  <span class="post-author-handle">@<%= post.user.username %></span>
                  <span class="post-meta">· <%= new Date(post.created_at).toLocaleDateString() %></span>
                </div>
              </div>
              
              <div class="post-body">
                <%= escapeHtml(post.body || '') %>
              </div>
            </article>
          <% } %>
          
          <div class="post-actions" style="display:flex;gap:12px;padding-top:12px;border-top:1px solid var(--border-color);">
            <button class="btn btn-secondary btn-sm" aria-label="Repost">Repost</button>
            <button class="btn btn-secondary btn-sm" aria-label="Share">Share</button>
          </div>
        </article>
      </div>
    <% }) %>
  <% } else { %>
    <div class="empty-state">
      <p>No posts yet. Create your first post!</p>
    </div>
  <% } %>
</div>
