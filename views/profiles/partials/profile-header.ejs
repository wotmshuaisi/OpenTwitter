<div class="profile-header">
  <% if (user.avatar_media_id) { %>
    <img class="avatar" src="/media/<%= user.avatar_media_id %>storage_key" alt="<%= user.display_name %>">
  <% } else { %>
    <div class="avatar" style="width:120px;height:120px;background:var(--bg-secondary);border-radius:50%;"></div>
  <% } %>
  
  <h1 class="name"><%= escapeHtml(user.display_name) %></h1>
  <p class="handle">@<%= user.username %></p>
  
  <% if (user.bio) { %>
  <p style="color:var(--text-secondary);margin-bottom:12px;"><%= escapeHtml(user.bio) %></p>
  <% } %>
  
  <p style="color:var(--text-secondary);"><%= user.location %></p>
  <% if (user.website) { %>
  <p style="color:var(--text-secondary);">
    <a href="<%= escapeHtml(user.website) %>"><%= escapeHtml(user.website) %></a>
  </p>
  <% } %>
  
  <% if (user.header_media_id) { %>
  <img style="width:100%;height:200px;border-radius:8px;margin-top:24px;" src="/media/<%= user.header_media_id %>storage_key" alt="Header image">
  <% } %>
  
  <div class="stats">
    <div class="stat-item">
      <div class="stat-value"><%= user.followerCount %></div>
      <div class="stat-label">Followers</div>
    </div>
    <div class="stat-item">
      <div class="stat-value"><%= user.followingCount %></div>
      <div class="stat-label">Following</div>
    </div>
  </div>
</div>
