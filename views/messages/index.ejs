<% include '../partials/nav.ejs' %>

<h1 class="text-center" style="margin-top: 40px;">Messages</h1>

<div class="card" style="margin-top: 24px;">
  <div id="conversations-list" class="conversation-list">
    <div class="empty-state">
      <p>Loading conversations...</p>
    </div>
  </div>
</div>

<script>
// Fetch conversations
fetch('/api/messages/conversations').then(response => response.json()).then(data => {
  const conversations = data.conversations;
  
  if (conversations.length > 0) {
    const html = conversations.map(conv => {
      return '<div class="conversation-item" style="display:flex;gap:12px;padding:12px;border-bottom:1px solid var(--border-color);cursor:pointer" data-conversation-id="' + conv.id + '">' +
        '<div style="width:40px;height:40px;background:var(--bg-secondary);border-radius:50%;"></div>' +
        '<div style="flex:1;">' +
          '<div style="display:flex;justify-content:space-between;">' +
            '<a href="/u/' + conv.participant.username + '" class="conversation-name">' + escapeHtml(conv.participant.displayName) + '</a>' +
            '<span class="unread-badge" style="background:var(--accent-color);color:white;border-radius:999px;padding:2px 8px;font-size:12px;">' + conv.unread + '</span>' +
          '</div>' +
          '<div style="color:var(--text-secondary);font-size:12px;">' + escapeHtml(conv.lastMessage) + '</div>' +
        '</div>' +
      '</div>';
    }).join('');
    
    document.getElementById('conversations-list').innerHTML = html;
    
    // Add click handlers
    conversations.forEach(conv => {
      const element = document.querySelector(`[data-conversation-id="${conv.id}"]`);
      if (element) {
        element.onclick = function() {
          window.location.href = '/messages/' + conv.id;
        };
      }
    });
  } else {
    document.getElementById('conversations-list').innerHTML = '<div class="empty-state"><p>No conversations yet. Start a conversation with someone!</p></div>';
  }
}).catch(error => {
  console.error('Error loading conversations:', error);
  document.getElementById('conversations-list').innerHTML = '<div class="empty-state"><p>Error loading conversations.</p></div>';
});
</script>
