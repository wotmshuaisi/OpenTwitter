<!DOCTYPE html>
<html lang="en" data-theme="<%= (user ? user.theme_preference : 'system') %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= document.title || 'Twitter-like' %></title>
  
  <!-- htmx -->
  <script src="/htmx.min.js"></script>
  
  <style>
    /* Theme variables */
    :root {
      --bg-primary: #ffffff;
      --bg-secondary: #f7f9fa;
      --text-primary: #0f1419;
      --text-secondary: #536471;
      --border-color: #eff3f4;
      --accent-color: #1d9bf0;
      --accent-hover: #1a8cd8;
      --success-color: #00ba7c;
      --danger-color: #f4212e;
      --card-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }
    
    [data-theme="dark"] {
      --bg-primary: #000000;
      --bg-secondary: #15202b;
      --text-primary: #e7e9ea;
      --text-secondary: #71767b;
      --border-color: #2f3336;
      --accent-color: #1d9bf0;
      --accent-hover: #1a8cd8;
      --success-color: #00ba7c;
      --danger-color: #f4212e;
      --card-shadow: 0 1px 2px rgba(0,0,0,0.5);
    }
    
    [data-theme="light"] {
      --bg-primary: #ffffff;
      --bg-secondary: #f7f9fa;
      --text-primary: #0f1419;
      --text-secondary: #536471;
      --border-color: #eff3f4;
      --accent-color: #1d9bf0;
      --accent-hover: #1a8cd8;
      --success-color: #00ba7c;
      --danger-color: #f4212e;
      --card-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-secondary);
      color: var(--text-primary);
      min-height: 100vh;
    }
    
    a {
      color: var(--accent-color);
      text-decoration: none;
    }
    
    a:hover {
      text-decoration: underline;
    }
    
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 16px;
    }
    
    /* Navigation */
    .navbar {
      background-color: var(--bg-primary);
      border-bottom: 1px solid var(--border-color);
      padding: 12px 16px;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    
    .navbar-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    
    .logo {
      font-size: 24px;
      font-weight: bold;
      color: var(--text-primary);
      margin: 0;
    }
    
    .nav-links {
      display: flex;
      gap: 20px;
    }
    
    .nav-link {
      color: var(--text-secondary);
      font-size: 16px;
    }
    
    .nav-link:hover {
      color: var(--text-primary);
      text-decoration: underline;
    }
    
    /* Theme toggle */
    .theme-toggle {
      background: none;
      border: none;
      color: var(--text-primary);
      cursor: pointer;
      font-size: 20px;
      padding: 4px;
    }
    
    /* Cards */
    .card {
      background-color: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      margin-bottom: 16px;
      box-shadow: var(--card-shadow);
    }
    
    /* Buttons */
    .btn {
      display: inline-block;
      padding: 8px 16px;
      border-radius: 9999px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: background-color 0.2s;
    }
    
    .btn-primary {
      background-color: var(--accent-color);
      color: white;
    }
    
    .btn-primary:hover {
      background-color: var(--accent-hover);
    }
    
    .btn-secondary {
      background-color: var(--bg-secondary);
      color: var(--text-primary);
    }
    
    .btn-secondary:hover {
      background-color: var(--border-color);
    }
    
    .btn-danger {
      background-color: var(--danger-color);
      color: white;
    }
    
    .btn-danger:hover {
      background-color: #d61f22;
    }
    
    .btn-sm {
      padding: 4px 10px;
      font-size: 12px;
    }
    
    /* Forms */
    .form-group {
      margin-bottom: 16px;
    }
    
    .form-group label {
      display: block;
      margin-bottom: 6px;
      font-size: 14px;
      color: var(--text-primary);
    }
    
    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--border-color);
      border-radius: 9999px;
      font-size: 14px;
      background-color: var(--bg-primary);
      color: var(--text-primary);
    }
    
    .form-group input:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--accent-color);
    }
    
    .form-group textarea {
      min-height: 100px;
      resize: vertical;
    }
    
    .error-message {
      color: var(--danger-color);
      font-size: 12px;
      margin-top: 4px;
    }
    
    /* Posts */
    .post {
      padding: 12px;
    }
    
    .post-header {
      display: flex;
      align-items: center;
      margin-bottom: 8px;
    }
    
    .post-author {
      margin-right: 8px;
    }
    
    .post-author img {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      object-fit: cover;
    }
    
    .post-author-name {
      font-weight: 600;
      font-size: 14px;
    }
    
    .post-author-handle {
      color: var(--text-secondary);
      font-size: 14px;
    }
    
    .post-body {
      font-size: 14px;
      line-height: 1.5;
      margin-bottom: 12px;
    }
    
    .post-meta {
      color: var(--text-secondary);
      font-size: 12px;
    }
    
    /* Composer */
    .composer {
      padding: 12px;
    }
    
    .composer textarea {
      border-radius: 999px;
      border: none;
    }
    
    .composer-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 12px;
    }
    
    .composer-actions .btn {
      padding: 8px 24px;
    }
    
    /* Profile */
    .profile-header {
      padding: 24px;
      text-align: center;
    }
    
    .profile-header .avatar {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      margin: 0 auto 16px;
      border: 4px solid var(--bg-secondary);
    }
    
    .profile-header .name {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 4px;
    }
    
    .profile-header .handle {
      color: var(--text-secondary);
      margin-bottom: 12px;
    }
    
    .profile-header .stats {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-top: 16px;
    }
    
    .stat-item {
      text-align: center;
    }
    
    .stat-value {
      font-weight: 600;
      font-size: 16px;
    }
    
    .stat-label {
      font-size: 12px;
      color: var(--text-secondary);
    }
    
    /* Loading state */
    .loading {
      text-align: center;
      padding: 40px;
      color: var(--text-secondary);
    }
    
    .hidden {
      display: none !important;
    }
    
    /* Message bubbles */
    .message-bubble {
      padding: 12px;
      border-bottom: 1px solid var(--border-color);
    }
    
    .message-bubble:last-child {
      border-bottom: none;
    }
    
    .message-sent {
      background-color: var(--bg-secondary);
    }
    
    .message-received {
      background-color: var(--bg-primary);
    }
    
    /* Empty state */
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: var(--text-secondary);
    }
    
    /* Notifications */
    .notification {
      position: fixed;
      top: 20px;
      right: 20px;
      background-color: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 12px 20px;
      box-shadow: var(--card-shadow);
      z-index: 1000;
      animation: slideIn 0.3s ease;
    }
    
    @keyframes slideIn {
      from {
        transform: translateX(100%);
        opacity: 0;
      }
      to {
        transform: translateX(0);
        opacity: 1;
      }
    }
    
    /* Conversation list */
    .conversation-item {
      cursor: pointer;
      transition: background-color 0.2s;
    }
    
    .conversation-item:hover {
      background-color: var(--bg-secondary);
    }
    
    .conversation-name {
      font-weight: 600;
    }
    
    .unread-badge {
      background: var(--accent-color);
      color: white;
      border-radius: 999px;
      padding: 2px 8px;
      font-size: 12px;
    }
    
    /* User list */
    .user-item {
      display: flex;
      gap: 16px;
      padding: 12px;
      border-bottom: 1px solid var(--border-color);
      cursor: pointer;
      transition: background-color 0.2s;
    }
    
    .user-item:hover {
      background-color: var(--bg-secondary);
    }
    
    .user-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      object-fit: cover;
    }
    
    /* Activity item */
    .activity-item {
      display: flex;
      gap: 12px;
      padding: 12px 0;
      border-bottom: 1px solid var(--border-color);
    }
    
    .activity-item:last-child {
      border-bottom: none;
    }
    
    /* Post analytics */
    .post-analytics-item {
      display: flex;
      gap: 12px;
      padding: 12px 0;
      border-bottom: 1px solid var(--border-color);
    }
    
    .post-analytics-item:last-child {
      border-bottom: none;
    }
    
    /* Reduced motion preference */
    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
    
    /* Focus styles for accessibility */
    *:focus-visible {
      outline: 2px solid var(--accent-color);
      outline-offset: 2px;
    }
  </style>
</head>
<body>
  <!-- Notifications container -->
  <div id="notifications"></div>
  
  <!-- Navigation (hidden on login/logout pages) -->
  <% if (user && !isAuthPage) { %>
  <nav class="navbar">
    <div class="navbar-content">
      <h1 class="logo">Twitter-like</h1>
      <div class="nav-links">
        <a href="/feed" class="nav-link">Home</a>
        <a href="/messages" class="nav-link">Messages</a>
        <a href="/analytics" class="nav-link">Analytics</a>
        <a href="/u/<%= user.username %>" class="nav-link">Profile</a>
      </div>
      <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme">
        <% if (theme === 'dark') { %>
          ☀️
        <% } else if (theme === 'light') { %>
          🌙
        <% } else { %>
          ◑
        <% } %>
      </button>
    </div>
  </nav>
  <% } %>

  <!-- Main content -->
  <div class="container">
    <% yield %>
  </div>

  <script>
    // Theme toggle
    function toggleTheme() {
      const newTheme = document.querySelector('[data-theme]');
      if (newTheme.getAttribute('data-theme') === 'system') {
        newTheme.setAttribute('data-theme', 'light');
      } else if (newTheme.getAttribute('data-theme') === 'light') {
        newTheme.setAttribute('data-theme', 'dark');
      } else {
        newTheme.setAttribute('data-theme', 'system');
      }
      // Save preference
      localStorage.setItem('theme', newTheme.getAttribute('data-theme'));
    }
    
    // Set initial theme from localStorage or system preference
    (function setInitialTheme() {
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme) {
        document.querySelector('[data-theme]').setAttribute('data-theme', savedTheme);
      } else {
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.querySelector('[data-theme]').setAttribute('data-theme', systemDark ? 'dark' : 'light');
      }
    })();
    
    // Socket.io real-time updates
    const socket = new (require('socket.io-client').default || require('socket.io-client'))('/');
    
    socket.on('connect', () => {
      console.log('Socket connected');
    });
    
    socket.on('disconnect', () => {
      console.log('Socket disconnected');
    });
    
    socket.on('media:ready', (data) => {
      console.log('Media ready:', data);
      // Refresh the post that has this media
      window.location.reload();
    });
  </script>
</body>
</html>
